{
	# The firewall opens 443/tcp only, so HTTP/3 (443/udp) would never connect.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN} {
	# The API trusts exactly one proxy hop for X-Forwarded-Proto and X-Forwarded-For.
	handle /api/* {
		reverse_proxy api:3000
	}

	# OME: WHIP signalling and LL-HLS. Blocking playlist requests and chunked
	# partial segments must reach the player as soon as OME writes them.
	handle /app/* {
		reverse_proxy ome:3333 {
			flush_interval -1
		}
	}

	# Recordings (#19). OME writes tmp_* while recording and an info .xml
	# next to each file; only finished .mp4 files are served. file_server
	# answers Range requests, so the browser can seek and read the moov box
	# that OME writes at the end of the file.
	handle_path /recordings/* {
		root * /recordings
		file_server {
			hide tmp_* *.xml
		}
	}

	# Thumbnails (#62). The API writes .live-*.tmp and renames it over
	# live.jpg, so only finished images are served. nosniff keeps a browser
	# from reading an uploaded file as anything but the image it claims.
	handle_path /thumbnails/* {
		root * /thumbnails
		header X-Content-Type-Options nosniff
		file_server {
			hide *.tmp
		}
	}

	handle {
		root * /srv
		@hashed path /assets/*
		@unhashed not path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @unhashed Cache-Control "no-cache"
		encode zstd gzip
		try_files {path} /index.html
		file_server
	}
}
