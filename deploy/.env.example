# 서버에서 cp deploy/.env.example deploy/.env 후 채운다. deploy/compose.yaml이 이 파일을 읽는다.
# 저장소 루트의 .env(로컬 개발용)와 다른 파일이다.

# 서비스 도메인. Caddy가 이 이름으로 Let's Encrypt 인증서를 받는다. 예: lsp-live.duckdns.org
DOMAIN=
# OME가 ICE 후보와 TURN 주소로 알릴 서버 공인 IP (필수)
OME_HOST_IP=

# PostgreSQL. 비밀번호는 DATABASE_URL에 그대로 들어가므로 URL에 안전한 hex로 만든다. 예: openssl rand -hex 24
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# 세션 쿠키·송출 토큰 서명 키 (필수). 예: openssl rand -base64 32
SESSION_SECRET=
# OME Admission Webhook 서명 키 (필수). API와 OME가 같은 값을 읽는다. 예: openssl rand -base64 32
OME_WEBHOOK_SECRET=
# OME 관리 API 토큰 (필수). API와 OME가 같은 값을 읽는다. 예: openssl rand -hex 24
OME_API_ACCESS_TOKEN=

# 테스트 계정 원클릭 로그인. true일 때만 켜진다. 비밀번호는 시드에만 필요하다(8자 이상)
TEST_ACCOUNTS_ENABLED=
TEST_ACCOUNT_A_EMAIL=
TEST_ACCOUNT_A_NICKNAME=
TEST_ACCOUNT_A_PASSWORD=
TEST_ACCOUNT_B_EMAIL=
TEST_ACCOUNT_B_NICKNAME=
TEST_ACCOUNT_B_PASSWORD=

# 공개 포트. 서버에서는 비워 둔다(80, 443, 10000-10003/udp, 10000/tcp, 3478/tcp).
# 같은 기기에서 다른 스택과 함께 띄울 때만 바꾼다. ICE·TURN은 호스트와 컨테이너가 같은 번호를 쓴다
HTTP_PORT=
HTTPS_PORT=
OME_ICE_UDP_PORTS=
OME_ICE_TCP_PORT=
OME_TURN_PORT=

# DB 덤프. db-backup 서비스가 매일 04:00(KST)에 만든다. 비워 두면 괄호 안 기본값을 쓴다
# 덤프를 둘 호스트 폴더. 상대 경로는 deploy/ 기준이다 (./backups)
BACKUP_DIR=
# 이 일수보다 오래된 덤프를 지운다 (7)
BACKUP_RETENTION_DAYS=

# 녹화 (#19). 비워 두면 괄호 안 기본값을 쓴다
# 녹화 파일을 둘 호스트 폴더. 상대 경로는 deploy/ 기준이다 (./recordings). OME·API·Caddy가 함께 쓴다
RECORDINGS_DIR=
# 녹화 저장 용량 상한(GB). 넘으면 오래 전에 끝난 방송의 녹화부터 지운다 (10). 서버 디스크 여유를 보고 정한다
RECORDINGS_MAX_GB=

# 썸네일 (#62). 비워 두면 괄호 안 기본값을 쓴다
# 썸네일을 둘 호스트 폴더. 상대 경로는 deploy/ 기준이다 (./thumbnails). API가 쓰고 Caddy가 내준다
THUMBNAILS_DIR=

# 도네이션 (#20). 토스페이먼츠 결제위젯 테스트 키 (필수). 비어 있으면 docker compose가 시작하지 않는다
# 문서용 테스트 키(test_gck_docs_… / test_gsk_docs_…)의 출처: https://github.com/tosspayments/tosspayments-sample
# (express-react/server.js의 widgetSecretKey, express-react/src/pages/widget/WidgetCheckoutWindow.jsx의 clientKey)
# 테스트 키라 실제로 돈이 나가지 않는다. 라이브 키(live_…)는 넣지 않는다
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
