generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  nickname              String
  passwordHash          String
  createdAt             DateTime  @default(now())
  // The channel's standby image, thumbnails/users/<id>/standby.<ext>, shown
  // on the streamer's broadcasts before they go live. Both are null, or
  // both are set: the extension names the file and the time busts caches.
  standbyImageExt       String?
  standbyImageUpdatedAt DateTime?
  // The profile image, thumbnails/users/<id>/avatar.<ext>, stored like the
  // standby image: both null, or both set.
  avatarExt             String?
  avatarUpdatedAt       DateTime?
  // A short introduction on the channel page, 0-200 characters.
  bio                   String    @default("")
  // Lime the user holds (1 lime = 1 won). Only a conditional UPDATE that
  // adds or subtracts in SQL changes it, in the same transaction as the
  // LimeLedger row, so the ledger's deltas always sum to it.
  limeBalance           Int       @default(0)

  broadcasts        Broadcast[]
  comments          Comment[]
  chatMessages      ChatMessage[]
  donations         Donation[]    @relation("DonationDonor")
  receivedDonations Donation[]    @relation("DonationRecipient")
  following         Follow[]      @relation("Follower")
  followers         Follow[]      @relation("Followed")
  limeCharges       LimeCharge[]
  limeLedger        LimeLedger[]
}

enum BroadcastStatus {
  READY
  LIVE
  ENDED
}

// Only the server moves status forward (READY -> LIVE -> ENDED), from the
// publish admission flow. startedAt and endedAt record those transitions.
model Broadcast {
  id                 String          @id @default(uuid()) @db.Uuid
  streamerId         String          @db.Uuid
  streamer           User            @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  title              String
  description        String          @default("")
  status             BroadcastStatus @default(READY)
  startedAt          DateTime?
  endedAt            DateTime?
  disconnectedAt     DateTime?
  // Finalized recording files relative to the recordings root, oldest
  // first. The reconciler keeps this in step with the disk.
  recordingFiles     String[]        @default([])
  // When the video at 0 s of each recording file was recorded, read from
  // OME's info XML. Empty, or one per recordingFiles entry in the same order
  // (a CHECK in the migration holds this): a start that cannot be read
  // leaves the whole list empty.
  recordingStartedAt DateTime[]      @default([])
  // When the streamer's browser last uploaded thumbnails/<id>/live.jpg.
  // Null means the broadcast has no thumbnail.
  thumbnailUpdatedAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  comments     Comment[]
  chatMessages ChatMessage[]
  donations    Donation[]

  // PRD §7.4 one LIVE broadcast per streamer, held by the database so two
  // admissions racing for different broadcasts cannot both win.
  @@unique([streamerId], map: "Broadcast_one_live_per_streamer", where: raw("status = 'LIVE'"))
  @@index([status, createdAt])
  @@index([streamerId, createdAt])
}

// Deleting a broadcast or a user takes their comments with it. Comments have
// no soft delete either: an author's delete removes the row.
model Comment {
  id          String    @id @default(uuid()) @db.Uuid
  broadcastId String    @db.Uuid
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([broadcastId, createdAt])
}

// A line of chat sent while the broadcast is READY or LIVE. Chat is never
// edited, so it has no updatedAt. Deleting a broadcast or a user takes their
// chat with it, and an author's delete removes the row.
model ChatMessage {
  id          String    @id @default(uuid()) @db.Uuid
  broadcastId String    @db.Uuid
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())

  @@index([broadcastId, createdAt])
}

// A viewer following a streamer. Both ends are users, and deleting either
// user takes the follow with it.
model Follow {
  followerId String   @db.Uuid
  streamerId String   @db.Uuid
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  streamer   User     @relation("Followed", fields: [streamerId], references: [id], onDelete: Cascade)

  @@id([followerId, streamerId])
  @@index([streamerId])
}

enum DonationStatus {
  PENDING
  PAID
}

// TOSS donations are paid card by card through Toss. LIME donations spend
// the donor's lime balance.
enum DonationMethod {
  TOSS
  LIME
}

// An order becomes a donation when Toss approves it, and only PAID rows count
// toward a broadcast's total. A PENDING row is an order the donor has not paid
// for yet, or whose confirm failed and may still be retried.
//
// A donation is a record of money, so it outlives the broadcast (#114):
// deleting the broadcast only clears broadcastId. A lime donation's
// LimeLedger row keeps pointing at it, and a PENDING card order whose
// broadcast is gone can no longer be confirmed.
model Donation {
  id          String         @id @default(uuid()) @db.Uuid
  // Sent to Toss as its orderId, which allows 6-64 of [A-Za-z0-9-_=].
  orderId     String         @unique
  // Null once the broadcast has been deleted.
  broadcastId String?        @db.Uuid
  broadcast   Broadcast?     @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  donorId     String         @db.Uuid
  donor       User           @relation("DonationDonor", fields: [donorId], references: [id], onDelete: Cascade)
  // The streamer the donation went to, copied from the broadcast when it is
  // made so it survives the broadcast's deletion. Null only on donations
  // whose broadcast was deleted before this column existed.
  recipientId String?        @db.Uuid
  recipient   User?          @relation("DonationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  amount      Int
  message     String         @default("")
  status      DonationStatus @default(PENDING)
  method      DonationMethod @default(TOSS)
  paymentKey  String?        @unique
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([broadcastId, status, approvedAt])
  @@index([recipientId, status, approvedAt])
  @@index([donorId, status, approvedAt])
}

// FAILED means Toss refused the last confirm. Like a PENDING order, it may
// still be confirmed by a retry. Only APPROVED orders have credited lime.
enum LimeChargeStatus {
  PENDING
  APPROVED
  FAILED
}

// A lime top-up paid through Toss. It credits the buyer's balance once,
// when it turns APPROVED.
model LimeCharge {
  id         String           @id @default(uuid()) @db.Uuid
  // Sent to Toss as its orderId, which allows 6-64 of [A-Za-z0-9-_=].
  orderId    String           @unique
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  status     LimeChargeStatus @default(PENDING)
  paymentKey String?          @unique
  approvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
}

enum LimeLedgerKind {
  CHARGE
  DONATION
}

// Every change to User.limeBalance, written in the same transaction. refId
// is the LimeCharge or Donation id behind it, and (kind, refId) is unique so
// one charge or donation can never move the balance twice.
model LimeLedger {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Positive for a charge, negative for a donation.
  delta        Int
  kind         LimeLedgerKind
  refId        String         @db.Uuid
  balanceAfter Int
  createdAt    DateTime       @default(now())

  @@unique([kind, refId])
  @@index([userId, createdAt])
}

// connect-pg-simple reads and writes this table. Its shape follows the
// library's table.sql so the session store and the migrations agree.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
