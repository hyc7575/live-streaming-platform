generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  nickname     String
  passwordHash String
  createdAt    DateTime @default(now())

  broadcasts Broadcast[]
}

enum BroadcastStatus {
  READY
  LIVE
  ENDED
}

// Only the server moves status forward (READY -> LIVE -> ENDED), from the
// publish admission flow. startedAt and endedAt record those transitions.
model Broadcast {
  id          String          @id @default(uuid()) @db.Uuid
  streamerId  String          @db.Uuid
  streamer    User            @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  status      BroadcastStatus @default(READY)
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([streamerId, createdAt])
}

// connect-pg-simple reads and writes this table. Its shape follows the
// library's table.sql so the session store and the migrations agree.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
