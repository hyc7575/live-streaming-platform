generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  nickname              String
  passwordHash          String
  createdAt             DateTime  @default(now())
  // 채널의 기본 대기 이미지. thumbnails/users/<id>/standby.<ext>에 두고,
  // 스트리머의 방송이 라이브 전일 때 보여 준다. 둘 다 null이거나
  // 둘 다 값이 있다. 확장자는 파일 이름을 정하고, 시각은 캐시를 깬다.
  standbyImageExt       String?
  standbyImageUpdatedAt DateTime?
  // 프로필 이미지. thumbnails/users/<id>/avatar.<ext>에 두고,
  // 기본 대기 이미지처럼 저장한다. 둘 다 null이거나 둘 다 값이 있다.
  avatarExt             String?
  avatarUpdatedAt       DateTime?
  // 채널 페이지에 보이는 짧은 소개. 0-200자.
  bio                   String    @default("")
  // 사용자가 가진 라임(1 라임 = 1원). SQL에서 더하거나 빼는 조건부 UPDATE만
  // 이 값을 바꾸고, LimeLedger 행과 같은 트랜잭션에서 바꾸므로
  // 원장 변동분의 합은 언제나 이 값과 같다.
  limeBalance           Int       @default(0)

  broadcasts        Broadcast[]
  comments          Comment[]
  chatMessages      ChatMessage[]
  donations         Donation[]    @relation("DonationDonor")
  receivedDonations Donation[]    @relation("DonationRecipient")
  following         Follow[]      @relation("Follower")
  followers         Follow[]      @relation("Followed")
  limeCharges       LimeCharge[]
  limeLedger        LimeLedger[]
}

enum BroadcastStatus {
  READY
  LIVE
  ENDED
}

// 방송의 대분류(PRD-category 7.1). 화면 이름은 게임·소통·음악·공부/작업·스포츠·기타다.
// null을 두지 않고 기본값을 ETC로 해서 목록 필터가 단순하다.
enum BroadcastCategory {
  GAME
  TALK
  MUSIC
  STUDY
  SPORTS
  ETC
}

// status는 서버만 앞으로 옮긴다(READY -> LIVE -> ENDED). 송출 허가 흐름에서
// 옮긴다. startedAt과 endedAt은 그 전이 시각을 기록한다.
model Broadcast {
  id                 String            @id @default(uuid()) @db.Uuid
  streamerId         String            @db.Uuid
  streamer           User              @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  title              String
  description        String            @default("")
  category           BroadcastCategory @default(ETC)
  // 게임 타이틀 스냅샷(PRD-category 7.1). category가 GAME일 때만 있다.
  // gameQid가 있으면 저장 시점의 Game.nameKo가 gameName이고, gameName만 있으면
  // 직접 입력이다. 다음 가져오기에서 그 게임이 빠져도 방송은 그대로 보여야 해서
  // Game과 외래 키를 걸지 않는다. 마이그레이션의 CHECK가 위 규칙을 지킨다.
  gameQid            String?
  gameName           String?
  status             BroadcastStatus   @default(READY)
  startedAt          DateTime?
  endedAt            DateTime?
  disconnectedAt     DateTime?
  // 확정된 녹화 파일. 녹화 루트 기준 상대 경로이고 오래된 것이
  // 먼저 온다. reconciler가 디스크와 맞춰 둔다.
  recordingFiles     String[]          @default([])
  // 각 녹화 파일의 0초 지점 영상이 녹화된 시각. OME의
  // info XML에서 읽는다. 비어 있거나, recordingFiles 항목마다 같은 순서로 하나씩 있다
  // (마이그레이션의 CHECK가 이를 지킨다). 시작 시각을 하나라도 읽지 못하면
  // 목록 전체를 비운다.
  recordingStartedAt DateTime[]        @default([])
  // 스트리머 브라우저가 thumbnails/<id>/live.jpg를 마지막으로 올린 시각.
  // null이면 방송에 썸네일이 없다.
  thumbnailUpdatedAt DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  comments     Comment[]
  chatMessages ChatMessage[]
  donations    Donation[]

  // PRD §7.4 스트리머당 LIVE 방송 하나. 데이터베이스가 지켜서, 서로 다른 방송을
  // 두고 경쟁하는 두 송출 허가가 함께 이길 수 없다.
  @@unique([streamerId], map: "Broadcast_one_live_per_streamer", where: raw("status = 'LIVE'"))
  @@index([status, createdAt])
  @@index([streamerId, createdAt])
}

// Wikidata에서 받은 게임 목록(PRD-category 7.1·7.2). apps/api/data/games.json을
// db:seed가 그대로 옮긴다. 파일에 없는 행은 지운다. 런타임은 Wikidata를 부르지 않는다.
model Game {
  qid        String   @id
  nameKo     String
  nameEn     String?
  aliasesKo  String[] @default([])
  // nameKo·nameEn·aliasesKo를 공백 없이 소문자로 이은 값. "리그오브레전드"로 쳐도
  // "리그 오브 레전드"를 찾게 한다.
  searchText String
  updatedAt  DateTime @updatedAt
}

// 방송이나 사용자를 지우면 그 댓글도 함께 지워진다. 댓글에도
// soft delete는 없다. 작성자가 지우면 행이 삭제된다.
model Comment {
  id          String    @id @default(uuid()) @db.Uuid
  broadcastId String    @db.Uuid
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([broadcastId, createdAt])
}

// 방송이 READY나 LIVE일 때 보낸 채팅 한 줄. 채팅은 수정하지 않으므로
// updatedAt이 없다. 방송이나 사용자를 지우면 그 채팅도 함께 지워지고,
// 작성자가 지우면 행이 삭제된다.
model ChatMessage {
  id          String    @id @default(uuid()) @db.Uuid
  broadcastId String    @db.Uuid
  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  authorId    String    @db.Uuid
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body        String
  createdAt   DateTime  @default(now())

  @@index([broadcastId, createdAt])
}

// 시청자가 스트리머를 팔로우한 관계. 양쪽 모두 사용자이고, 어느 쪽
// 사용자를 지워도 팔로우가 함께 지워진다.
model Follow {
  followerId String   @db.Uuid
  streamerId String   @db.Uuid
  createdAt  DateTime @default(now())
  follower   User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  streamer   User     @relation("Followed", fields: [streamerId], references: [id], onDelete: Cascade)

  @@id([followerId, streamerId])
  @@index([streamerId])
}

enum DonationStatus {
  PENDING
  PAID
}

// TOSS 후원은 Toss를 거쳐 건마다 카드로 결제한다. LIME 후원은
// 후원자의 라임 잔액을 쓴다.
enum DonationMethod {
  TOSS
  LIME
}

// 주문은 Toss가 승인하면 후원이 되고, PAID 행만 방송 합계에
// 들어간다. PENDING 행은 후원자가 아직 결제하지 않은 주문이거나,
// 승인에 실패했지만 아직 재시도할 수 있는 주문이다.
//
// 후원은 돈의 기록이라 방송보다 오래 남는다(#114).
// 방송을 지우면 broadcastId만 비운다. 라임 후원의
// LimeLedger 행은 계속 이 후원을 가리키고, 방송이 사라진 PENDING 카드 주문은
// 더는 승인할 수 없다.
model Donation {
  id          String         @id @default(uuid()) @db.Uuid
  // Toss에 orderId로 보낸다. Toss는 [A-Za-z0-9-_=] 6~64자를 허용한다.
  orderId     String         @unique
  // 방송이 삭제되면 null이다.
  broadcastId String?        @db.Uuid
  broadcast   Broadcast?     @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  donorId     String         @db.Uuid
  donor       User           @relation("DonationDonor", fields: [donorId], references: [id], onDelete: Cascade)
  // 후원을 받은 스트리머. 후원을 만들 때 방송에서 복사해 두어
  // 방송이 삭제돼도 남는다. 이 컬럼이 생기기 전에 방송이 삭제된
  // 후원에서만 null이다.
  recipientId String?        @db.Uuid
  recipient   User?          @relation("DonationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  amount      Int
  message     String         @default("")
  status      DonationStatus @default(PENDING)
  method      DonationMethod @default(TOSS)
  paymentKey  String?        @unique
  approvedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([broadcastId, status, approvedAt])
  @@index([recipientId, status, approvedAt])
  @@index([donorId, status, approvedAt])
}

// FAILED는 Toss가 마지막 승인을 거절했다는 뜻이다. PENDING 주문처럼
// 재시도로 아직 승인될 수 있다. APPROVED 주문만 라임을 적립했다.
enum LimeChargeStatus {
  PENDING
  APPROVED
  FAILED
}

// Toss로 결제한 라임 충전. APPROVED가 될 때
// 구매자 잔액에 한 번 적립한다.
model LimeCharge {
  id         String           @id @default(uuid()) @db.Uuid
  // Toss에 orderId로 보낸다. Toss는 [A-Za-z0-9-_=] 6~64자를 허용한다.
  orderId    String           @unique
  userId     String           @db.Uuid
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Int
  status     LimeChargeStatus @default(PENDING)
  paymentKey String?          @unique
  approvedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
}

enum LimeLedgerKind {
  CHARGE
  DONATION
}

// User.limeBalance의 모든 변경. 같은 트랜잭션에서 쓴다. refId는
// 그 변경의 근거인 LimeCharge 또는 Donation id이고, (kind, refId)가 유일해서
// 충전이나 후원 하나가 잔액을 두 번 움직일 수 없다.
model LimeLedger {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 충전이면 양수, 후원이면 음수.
  delta        Int
  kind         LimeLedgerKind
  refId        String         @db.Uuid
  balanceAfter Int
  createdAt    DateTime       @default(now())

  @@unique([kind, refId])
  @@index([userId, createdAt])
}

// connect-pg-simple이 이 테이블을 읽고 쓴다. 구조는 라이브러리의
// table.sql을 따라서, 세션 저장소와 마이그레이션이 일치한다.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
