# cp .env.example .env 후 필요한 값만 채운다. 비워 둔 항목은 기본값을 쓴다.
# compose.yaml, apps/api, apps/web이 모두 저장소 루트의 .env 하나를 읽는다.

# docker compose 프로젝트 이름. worktree마다 다르게 두면 컨테이너·볼륨이 섞이지 않는다. 기본값 lsp
COMPOSE_PROJECT_NAME=

# PostgreSQL (compose). 비우면 lsp / lsp / lsp, 호스트 포트 5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST_PORT=

# API·Prisma·테스트가 쓸 DB 연결 문자열 (필수). 예시 형식: postgresql://<user>:<password>@localhost:<POSTGRES_HOST_PORT>/<db>
DATABASE_URL=
# 세션 쿠키 서명 키 (필수). 긴 무작위 문자열. 예: openssl rand -base64 32
SESSION_SECRET=
# OME Admission Webhook 서명 키 (필수). API가 송출 허가 요청의 서명을 이 값으로 검증하고, compose의 OME도 같은 값으로 서명한다. 예: openssl rand -base64 32
OME_WEBHOOK_SECRET=
# production이면 세션 쿠키에 Secure를 붙인다. 로컬 http 개발에서는 비워 둔다
NODE_ENV=

# 테스트 계정 원클릭 로그인. true일 때만 로그인 화면에 버튼이 보이고 POST /api/auth/test-login이 동작한다
TEST_ACCOUNTS_ENABLED=
# 시드(pnpm --filter @lsp/api db:seed)가 만드는 계정. 비밀번호는 필수(8자 이상), 이메일·닉네임은 비우면 기본값
TEST_ACCOUNT_A_EMAIL=
TEST_ACCOUNT_A_NICKNAME=
TEST_ACCOUNT_A_PASSWORD=
TEST_ACCOUNT_B_EMAIL=
TEST_ACCOUNT_B_NICKNAME=
TEST_ACCOUNT_B_PASSWORD=

# 개발 서버 포트. 비우면 API 3000, 웹 5173
API_PORT=
WEB_PORT=
# 같은 Wi-Fi 휴대폰 확인용 웹 https 인증서(저장소 루트 기준 경로). 둘 다 있으면 웹이 https로 LAN에 열린다
# scripts/lan-https.sh가 만든다. e2e는 http로 접속하므로 e2e를 돌릴 때는 비운다
WEB_HTTPS_CERT=
WEB_HTTPS_KEY=

# OvenMediaEngine (compose). 호스트와 컨테이너가 같은 포트 번호를 쓴다
# OME_HOST_IP: ICE 후보에 적을 주소. 비우면 OME가 자기 인터페이스 주소를 쓴다
# 같은 Mac의 브라우저에서 송출하려면 127.0.0.1을 넣는다. 비우면 ICE가 연결되지 않는다(#2 실측). 서버는 공인 IP
# 같은 Wi-Fi 휴대폰에서 송출하려면 Mac의 LAN IP(ipconfig getifaddr en0). 바꾸면 docker compose up -d ome로 OME를 다시 만든다
OME_HOST_IP=
# 시그널링 + LL-HLS. 기본값 3333
OME_HTTP_PORT=
# WebRTC ICE UDP 범위. 기본값 10000-10003
OME_ICE_UDP_PORTS=
# WebRTC ICE TCP. 기본값 10000
OME_ICE_TCP_PORT=
# 내장 TURN (TCP). 기본값 3478
OME_TURN_PORT=
# OME가 송출 허가를 물을 API 주소. 비우면 http://host.docker.internal:${API_PORT}/api/ome/admission
OME_WEBHOOK_URL=
# OME 관리 API 토큰 (필수). API가 방송 종료 때 이 값으로 송출 연결을 끊고, compose의 OME도 같은 값을 쓴다. 예: openssl rand -hex 24
OME_API_ACCESS_TOKEN=
# OME 관리 API의 호스트 포트. 127.0.0.1에만 열린다. 기본값 8081
OME_API_PORT=
# API가 부를 OME 관리 API 주소. 비우면 http://127.0.0.1:${OME_API_PORT}
OME_API_URL=

# 녹화·다시보기 (#19)
# 녹화 파일 폴더. OME가 쓰고, API가 용량을 재고 지우고, 개발용 정적 서버가 /recordings로 내준다
# 비우면 저장소 루트의 recordings/. 바꾸려면 절대 경로를 넣는다(API는 apps/api에서 돌아 상대 경로가 어긋난다)
RECORDINGS_DIR=
# 녹화 저장 용량 상한(GB). 넘으면 오래 전에 끝난 방송의 녹화부터 지운다. 기본값 10
RECORDINGS_MAX_GB=
# 개발용 녹화 정적 서버의 호스트 포트(127.0.0.1에만 열린다). Vite가 /recordings를 여기로 넘긴다. 기본값 8090
RECORDINGS_HTTP_PORT=
