{
  "name": "live-streaming-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint && prettier --check .",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
